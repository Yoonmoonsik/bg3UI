                <ls:LSRadioButton x:Name="SpellbookToggleButton" BoundEvent="ToggleSpells" Content="{Binding Source='h15329947gc691g4323gac0fge3fbcecb92d9',Converter={StaticResource TranslatedStringConverter}}">

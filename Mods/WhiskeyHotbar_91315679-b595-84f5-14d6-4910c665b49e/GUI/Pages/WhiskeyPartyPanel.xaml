                                     TEST: fixed Width = 808 + 3 * ScaledSlotSize. A hidden spacer only set a minimum, so the Character Sheet tab stretched the panel
                                     and the inventory grew to 17 columns after switching back -->
                                <Grid>
                                    <Grid.Width>
                                        <MultiBinding Converter="{StaticResource AddMultipleConverter}">
                                            <Binding Source="808"/>
                                            <Binding Source="{StaticResource ScaledSlotSize}"/>
                                            <Binding Source="{StaticResource ScaledSlotSize}"/>
                                            <Binding Source="{StaticResource ScaledSlotSize}"/>
                                        </MultiBinding>
                                    </Grid.Width>
                                    <Grid.Resources>
                                        <BitmapImage  x:Key="DecorHighlight_corner" UriSource="pack://application:,,,/Core;component/Assets/CharacterPanel/Selected_Decor_Corners.png" />
                                        <BitmapImage  x:Key="DecorHighlight_straight" UriSource="pack://application:,,,/Core;component/Assets/CharacterPanel/Selected_Decor_Top.png" />

                        <b:EventTrigger EventName="Click">
                            <b:InvokeCommandAction Command="{Binding ClearFilterCommand}"/>
                            <b:InvokeCommandAction Command="{Binding CustomEvent}" CommandParameter="ClosePartyPanel"/>

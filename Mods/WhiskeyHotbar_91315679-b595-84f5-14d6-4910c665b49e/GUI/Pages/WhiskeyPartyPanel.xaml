                            <ColumnDefinition x:Name="ClassPanelLeftColumn" Width="*"/>
                            <ColumnDefinition x:Name="ClassPanelCentralColumn" Width="1124"/>
                            <ColumnDefinition x:Name="ClassPanelRightColumn" Width="*"/>

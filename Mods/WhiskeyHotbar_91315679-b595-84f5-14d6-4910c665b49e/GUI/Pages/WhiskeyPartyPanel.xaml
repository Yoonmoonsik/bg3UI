                                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource LS_accent100TxtColor}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
